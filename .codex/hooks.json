{
  "description": "Prepara l'ambiente locale del repository prima del lavoro.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"",
            "timeout": 1800,
            "statusMessage": "Preparo l'ambiente del repository"
          }
        ]
      }
    ]
  }
}
