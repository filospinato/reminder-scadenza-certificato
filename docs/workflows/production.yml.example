# MODELLO NON ATTIVO: prima del go-live aggiungere la singola schedule autorizzata.
name: Reminder certificati produzione

on:
  workflow_dispatch:
    inputs:
      max_sends:
        description: Numero massimo di invii reali in questa esecuzione
        required: true
        type: choice
        default: "1"
        options:
          - "1"
          - "5"
          - "10"

permissions:
  contents: read
  id-token: write

concurrency:
  group: reminder-certificati-runtime
  cancel-in-progress: false

jobs:
  reminder:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: production
    env:
      GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
      GCP_WORKLOAD_IDENTITY_PROVIDER: ${{ vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
      GCP_SERVICE_ACCOUNT: ${{ vars.GCP_SERVICE_ACCOUNT }}
      OPERATIVO_SPREADSHEET_ID: ${{ vars.OPERATIVO_SPREADSHEET_ID }}
      ADMIN_SPREADSHEET_ID: ${{ vars.ADMIN_SPREADSHEET_ID }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Autenticazione Google temporanea
        id: auth
        uses: google-github-actions/auth@v3
        with:
          project_id: ${{ vars.GCP_PROJECT_ID }}
          workload_identity_provider: ${{ vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ vars.GCP_SERVICE_ACCOUNT }}
          create_credentials_file: true

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install
        run: pip install -e ".[google]"

      - name: Esecuzione produzione
        env:
          SMTP_HOST: ${{ secrets.SMTP_HOST }}
          SMTP_PORT: ${{ secrets.SMTP_PORT }}
          SMTP_SECURITY: ${{ secrets.SMTP_SECURITY }}
          ALLOW_PLAIN_SMTP: ${{ vars.ALLOW_PLAIN_SMTP }}
          SMTP_FROM: ${{ secrets.SMTP_FROM }}
          SMTP_REPLY_TO: ${{ vars.SMTP_REPLY_TO }}
          SMTP_USERNAME: ${{ secrets.SMTP_USERNAME }}
          SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
        run: reminder-certificati produzione --max-sends "${{ inputs.max_sends || '10' }}"

# Prima dell'attivazione:
# 1. vincolare WIF a questo workflow_ref o all'environment production;
# 2. approvare mittente, Reply-To, contenuto ed eventuale logo;
# 3. completare controllo e test SMTP con override;
# 4. iniziare manualmente con max_sends=1, poi 5 e infine 10;
# 5. aggiungere una sola schedule giornaliera e verificarne l'orario UTC;
# 6. impostare INVIO_AUTOMATICO_ATTIVO=true soltanto al go-live autorizzato.
