# MODELLO NON ATTIVO: non spostare in .github/workflows senza autorizzazione finale.
name: Reminder certificati produzione

on:
  workflow_dispatch:
  schedule:
    - cron: "15 6 * * *"

permissions:
  contents: read
  id-token: write

concurrency:
  # Deve essere lo stesso gruppo del workflow manuale: entrambi scrivono sullo
  # stesso registro, dashboard e tab anomalie.
  group: reminder-certificati-runtime
  cancel-in-progress: false

jobs:
  reminder:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: production
    env:
      PRODUCTION_ENABLED: ${{ vars.PRODUCTION_ENABLED }}
      GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
      GCP_WORKLOAD_IDENTITY_PROVIDER: ${{ vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
      GCP_SERVICE_ACCOUNT: ${{ vars.GCP_SERVICE_ACCOUNT }}
      OPERATIVO_SPREADSHEET_ID: ${{ vars.OPERATIVO_SPREADSHEET_ID }}
      OPERATIVO_SHEET_NAME: Operativo
      OPERATIVO_HEADER_ROW: "2"
      OPERATIVO_COLUMNS_A1: ${{ vars.OPERATIVO_COLUMNS_A1 }}
      ADMIN_SPREADSHEET_ID: ${{ vars.ADMIN_SPREADSHEET_ID }}
    steps:
      - name: Verifica abilitazione production
        id: gate
        shell: bash
        run: |
          set -euo pipefail
          if [[ "${PRODUCTION_ENABLED:-}" == "true" ]]; then
            echo "enabled=true" >> "$GITHUB_OUTPUT"
          else
            echo "enabled=false" >> "$GITHUB_OUTPUT"
            echo "Produzione non abilitata. Nessuna risorsa o email sarà utilizzata."
          fi

      - name: Checkout
        if: steps.gate.outputs.enabled == 'true'
        uses: actions/checkout@v4

      - name: Autenticazione Google temporanea
        if: steps.gate.outputs.enabled == 'true'
        id: auth
        uses: google-github-actions/auth@v3
        with:
          project_id: ${{ vars.GCP_PROJECT_ID }}
          workload_identity_provider: ${{ vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ vars.GCP_SERVICE_ACCOUNT }}
          create_credentials_file: true

      - name: Set up Python
        if: steps.gate.outputs.enabled == 'true'
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install
        if: steps.gate.outputs.enabled == 'true'
        run: pip install -e ".[google]"

      - name: Esecuzione produzione
        if: steps.gate.outputs.enabled == 'true'
        env:
          # I segreti SMTP sono disponibili soltanto allo step che li usa, non
          # alle azioni di checkout, autenticazione o setup.
          SMTP_HOST: ${{ secrets.SMTP_HOST }}
          SMTP_PORT: ${{ secrets.SMTP_PORT }}
          SMTP_SECURITY: ${{ secrets.SMTP_SECURITY }}
          SMTP_FROM: ${{ secrets.SMTP_FROM }}
          SMTP_FROM_NAME: ${{ vars.SMTP_FROM_NAME }}
          SMTP_REPLY_TO: ${{ vars.SMTP_REPLY_TO }}
          SMTP_USERNAME: ${{ secrets.SMTP_USERNAME }}
          SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
        run: reminder-certificati produzione

# Prima dell'attivazione:
# 1. vincolare WIF anche a questo workflow_ref o all'environment production;
# 2. approvare firma, logo, mittente, Reply-To e contenuto;
# 3. completare test SMTP e collaudo con override;
# 4. impostare AUTOMAZIONE_ATTIVA=true e INVII_REALI_ABILITATI=true in CONFIG;
# 5. impostare PRODUCTION_ENABLED=true soltanto dopo autorizzazione esplicita;
# 6. verificare l'orario UTC della schedule rispetto all'ora locale e all'ora legale.
